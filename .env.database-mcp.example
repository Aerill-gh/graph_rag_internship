# Read only by the Database MCP server; never commit the filled file.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=graphragfull
# Optional when the Desktop data directory is not ~/.Neo4jDesktop2.
# NEO4J_DESKTOP_HOME=
# Optional when more than one Desktop DBMS contains NEO4J_DATABASE.
# NEO4J_DESKTOP_DBMS_PATH=
# Optional when the Desktop-bundled Java runtime cannot be used.
# NEO4J_JAVA_HOME=
