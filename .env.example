# Azure OpenAI-compatible endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Foundry project (shared by the baseline agent and chatbot)
FOUNDRY_PROJECT_ENDPOINT=
# Baseline agent deployment
FOUNDRY_CHAT_DEPLOYMENT=
# Chatbot deployment (may match FOUNDRY_CHAT_DEPLOYMENT)
FOUNDRY_MODEL_NAME=
FOUNDRY_AGENT_NAME=
CHATBOT_BACKEND=
# Set false for Foundry chat without MCP or document retrieval.
CHATBOT_USE_DOCUMENTS=
# Legacy chatbot MCP proxy; the active chatbot API uses DATABASE_MCP_URL instead.
MCP_SERVER_URL=
MCP_SEARCH_TOOL=
# Database MCP gateway used by the chatbot and ingestion clients.
DATABASE_MCP_URL=
CHATBOT_API_URL=
BACKEND_API_URL=

# Single entrypoint: API/UI ports (defaults: 8000, 8001, 8501).
CHATBOT_PORT=
GRAPHRAG_PORT=
UI_PORT=

# Document Intelligence and Blob Storage
DOCINTEL_ENDPOINT=
STORAGE_ACCOUNT_NAME=
BLOB_CONTAINER=
BLOB_NAME=

# Neo4j credentials belong in .env.database-mcp, not the chatbot environment.

# Local chatbot API endpoints used by the Streamlit UI
BACKEND_API_URL =
CHATBOT_API_URL =