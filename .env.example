# Azure OpenAI-compatible endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Foundry project (shared by the baseline agent and chatbot)
FOUNDRY_PROJECT_ENDPOINT=
# Baseline agent deployment
FOUNDRY_CHAT_DEPLOYMENT=
# Chatbot deployment (may match FOUNDRY_CHAT_DEPLOYMENT)
FOUNDRY_MODEL_NAME=
FOUNDRY_AGENT_NAME=zava-chatbot
CHATBOT_BACKEND=foundry
# Set false for Foundry chat without MCP or document retrieval.
CHATBOT_USE_DOCUMENTS=true
# Local MCP server: uv run python -m Chatbot.mcp_server (see README for PYTHONPATH).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_SEARCH_TOOL=search_documents
CHATBOT_API_URL=http://127.0.0.1:8000/chat

# Document Intelligence and Blob Storage
DOCINTEL_ENDPOINT=
STORAGE_ACCOUNT_NAME=
BLOB_CONTAINER=docs
BLOB_NAME=role_library.pdf

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
